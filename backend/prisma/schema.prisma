generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  RESCHEDULED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(PATIENT)
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient ProfilePatient?
  doctor  ProfileDoctor?
}

model ProfilePatient {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappNumber String?
  dateOfBirth    DateTime?
  gender         Gender?
  appointments   Appointment[]
}

model ProfileDoctor {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty      String?
  experience     Int?     // in years
  qualifications String?
  biography      String?
  consultationFee Float   @default(0)
  isActive       Boolean  @default(true)
  profilePhoto   String?

  availabilities DoctorAvailability[]
  breaks         DoctorBreak[]
  appointments   Appointment[]
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  duration    Int      // duration in minutes
  price       Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
}

model Clinic {
  id          String   @id @default(uuid())
  name        String
  address     String
  phone       String
  email       String
  workingHours Json    // Format: { "monday": { "start": "09:00", "end": "18:00" }, ... }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
}

model DoctorAvailability {
  id          String        @id @default(uuid())
  doctorId    String
  doctor      ProfileDoctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int           // 0 = Sunday, 1 = Monday, ...
  startTime   String        // "09:00"
  endTime     String        // "17:00"
  isActive    Boolean       @default(true)

  @@unique([doctorId, dayOfWeek])
}

model DoctorBreak {
  id          String        @id @default(uuid())
  doctorId    String
  doctor      ProfileDoctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int           // 0 = Sunday, 1 = Monday, ...
  startTime   String        // "13:00"
  endTime     String        // "14:00"
}

model Appointment {
  id            String   @id @default(uuid())
  appointmentId String   @unique // e.g. APT-2026-000001
  patientId     String
  patient       ProfilePatient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId      String
  doctor        ProfileDoctor  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  serviceId     String
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clinicId      String?
  clinic        Clinic?        @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  date          DateTime       // The date of the appointment
  startTime     String         // "10:30"
  endTime       String         // "11:00"
  
  status        AppointmentStatus @default(PENDING_CONFIRMATION)
  
  // WhatsApp tracking
  waMessageId   String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // To prevent double booking
  @@unique([doctorId, date, startTime])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}
